datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}

// =============================================================================
// ALIVIA — Graph + Cases + Contributors + NFTs
// Spec: docs/specs/02-data-model.md
// No tocar las entidades Open SaaS de arriba (OCP): extender, no modificar.
// =============================================================================

enum NodeType {
  PERSONA
  CARGO
  EMPRESA
  CONTRATO
  FAMILIA
}

enum EdgeType {
  DESIGNO
  OCUPA_CARGO
  ES_PARIENTE_DE
  ES_DUENO_DE
  GANO
  DENUNCIADO_POR
  MENCIONADO_EN
}

/// Nodo polimórfico del grafo. `properties` (Json) carga los campos específicos
/// del tipo según 02-data-model §2 (full_name+aliases para PERSONA, title+institution
/// para CARGO, legal_name+ruc para EMPRESA, etc.).
model Node {
  id            String    @id @default(cuid())
  type          NodeType
  label         String
  properties    Json
  riskFlags     String[]  @default([])
  createdAt     DateTime  @default(now())
  createdBy     String              // pseudónimo del aportante o "system" (OSINT)
  sourceCaseId  String?
  evidenceHash  String?

  outgoingEdges Edge[]    @relation("source")
  incomingEdges Edge[]    @relation("target")
  cases         Case[]              // subject_node_id reverse

  @@index([type])
  @@index([label])
}

/// Arista tipada, dirigida (source → target). 7 tipos según 02-data-model §3.
model Edge {
  id            String    @id @default(cuid())
  type          EdgeType
  sourceNodeId  String
  targetNodeId  String
  properties    Json                // grado_familiar, porcentaje, etc.
  sourceCaseId  String?
  evidenceHash  String?
  confidence    Float     @default(0.5)
  createdAt     DateTime  @default(now())
  createdBy     String

  source        Node      @relation("source", fields: [sourceNodeId], references: [id])
  target        Node      @relation("target", fields: [targetNodeId], references: [id])

  @@index([type])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

/// Unidad de aporte ciudadano que cristaliza un señalamiento. Spec 02 §4.
/// El id tiene formato `alv-YYYY-MM-DD-NNNN`.
model Case {
  id                  String    @id
  caseType            String              // nepotismo | licitacion | electoral | otro
  subjectNodeId       String
  facts               Json                // string[] de hechos
  evidence            Json                // {type, value}[] de evidencias inline
  graphConnections    Json                // {node_id, relation, confidence}[]
  corroborationScore  Float
  reporterPseudonym   String
  status              String              // watchlist | published | archived | refuted
  evidenceHash        String
  nftTokenId          String?
  nftTxHash           String?
  createdAt           DateTime  @default(now())
  publishedAt         DateTime?

  subject             Node      @relation(fields: [subjectNodeId], references: [id])

  @@index([status])
  @@index([reporterPseudonym])
  @@index([subjectNodeId])
}

/// Aportante seudónimo. Lleva reputación on-chain (NFT-Aportante soulbound).
/// Sin PII. Spec 02 §5.1.
model Contributor {
  pseudonym            String    @id     // formato aportante-XXXX
  soulboundTokenId     String?
  trustScore           Float     @default(0.5)
  totalContributions   Int       @default(0)
  totalCorroborated    Int       @default(0)
  firstSeenAt          DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())
}

/// Evidencia individual referenciable por casos. Spec 02 §5.2.
model Evidence {
  id            String    @id @default(cuid())
  type          String              // link | image | document_reference | expediente | audio | video
  value         String              // URL o referencia
  contentHash   String              // sha256
  contributedBy String              // pseudónimo del aportante
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([contributedBy])
}

/// Cazarrecompensa con TSYS bloqueados. Spec 02 §5.3 + 03 caso 3.
model Bounty {
  id                String    @id @default(cuid())
  targetNodeId      String              // node objetivo (persona/empresa/caso)
  description       String
  amountTsys        Float
  nftBountyTokenId  String?
  status            String    @default("open")  // open | claimed | expired | cancelled
  claimCriteria     String
  postedBy          String              // pseudónimo del postor
  claimedBy         String?             // pseudónimo del claimer
  postedAt          DateTime  @default(now())
  claimedAt         DateTime?

  @@index([status])
  @@index([targetNodeId])
}

/// Estado de conversación con el agente, persistido entre turnos. 07.F2.6.
/// `state` carga el contexto del aporte parcial mientras el agente entrevista.
model ChatSession {
  id            String    @id @default(cuid())
  channel       String              // telegram | discord | web
  channelUserId String              // hash del id externo, NO PII
  pseudonym     String              // aportante-XXXX asignado a la sesión
  state         Json                // {intent, partialCase, turnCount, ...}
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([channel, channelUserId])
  @@index([pseudonym])
}
